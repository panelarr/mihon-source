<!--
  Logs go to standard output, as JSON lines (default) or plain text.
  MIHON_LOG_FORMAT: json | text      MIHON_LOG_LEVEL: TRACE | DEBUG | INFO | WARN | ERROR
-->
<configuration>
  <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
  <variable name="LOG_FORMAT" value="${MIHON_LOG_FORMAT:-json}" />
  <variable name="LOG_LEVEL" value="${MIHON_LOG_LEVEL:-INFO}" />

  <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
      <layout class="panelarr.mihonsource.logging.JsonLineLayout" />
    </encoder>
  </appender>

  <appender name="text" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- One line per request, without headers, so tokens never reach the log. -->
  <logger name="com.linecorp.armeria.logging.access" level="INFO" />
  <logger name="com.linecorp.armeria" level="WARN" />
  <logger name="io.netty" level="WARN" />

  <root level="${LOG_LEVEL}">
    <appender-ref ref="${LOG_FORMAT}" />
  </root>
</configuration>
